{
  "realm": "shinyoauthdb",
  "enabled": true,
  "attributes": {"CreateDefaultClientScopes": "true"},
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 600,
  "ssoSessionMaxLifespan": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopes": [
    {
      "name": "database.read",
      "description": "Access to the isolated PostgreSQL fixture",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "shiny-db",
      "name": "Shiny PostgreSQL browser fixture",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:18100/callback"],
      "webOrigins": ["http://localhost:18100"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["database.read"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "PostgreSQL resource audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "postgres-fixture",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shiny-wrong-audience",
      "name": "Wrong-resource browser fixture",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:18100/callback"],
      "webOrigins": ["http://localhost:18100"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["database.read"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "Different resource audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "other-fixture",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shiny-missing-scope",
      "name": "Missing-database-scope browser fixture",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:18100/callback"],
      "webOrigins": ["http://localhost:18100"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "PostgreSQL audience without permission",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "postgres-fixture",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Fixture",
      "email": "alice@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "alice-fixture-password", "temporary": false}]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Fixture",
      "email": "bob@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "bob-fixture-password", "temporary": false}]
    }
  ]
}
